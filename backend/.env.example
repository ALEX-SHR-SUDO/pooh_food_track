# ========================================
# Twilio WhatsApp Configuration
# ========================================

# Twilio Account SID (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token (from https://console.twilio.com)
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp sender number
# - Sandbox (testing): whatsapp:+14155238886
# - Production: whatsapp:+<your_approved_number>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ========================================
# Server Configuration
# ========================================

PORT=3000

# ========================================
# Optional Settings
# ========================================

# Enable debug logging (true/false)
DEBUG=false
