# ========================================
# Cudy LT500 Router Configuration
# ========================================

# Router IP Address
# - Local network: 192.168.10.1 (default)
# - ZeroTier VPN: Use the ZeroTier IP assigned to router (e.g., 10.147.20.2)
# - Public IP: If router has static public IP and port forwarding
ROUTER_IP=192.168.10.1

# Router Admin Credentials
ROUTER_USER=admin
ROUTER_PASS=admin

# ========================================
# Server Configuration
# ========================================

PORT=3000

# ========================================
# Optional Settings
# ========================================

# Enable debug logging (true/false)
DEBUG=false

# Connection timeout in milliseconds (default: 5000)
ROUTER_TIMEOUT=10000

# ========================================
# ZeroTier VPN Configuration (Optional)
# ========================================
# If you're using ZeroTier VPN to connect to your router remotely:
#
# 1. Create a ZeroTier network at https://my.zerotier.com
# 2. Install ZeroTier on both router and backend server
# 3. Join both devices to the same network
# 4. Update ROUTER_IP with the ZeroTier IP assigned to router
#
# Example ZeroTier IPs:
#   Router ZeroTier IP: 10.147.20.2
#   Backend ZeroTier IP: 10.147.20.1
#
# See ZEROTIER_VPN_SETUP.md for complete setup instructions
