# Cudy LT500 Router Configuration
# For local development
ROUTER_IP=192.168.10.1
ROUTER_PROTOCOL=http
ROUTER_USER=admin
ROUTER_PASS=admin
# ROUTER_STRICT_SSL=false  # Set to 'true' if router has valid SSL certificate

# For production (Render.com with ZeroTier)
# ROUTER_IP=pooh-zerotier-gateway:10000
# ROUTER_PROTOCOL=http
# ROUTER_STRICT_SSL=false

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Enable debug logging
DEBUG=false
