# Cudy LT500 Router Configuration
# For LOCAL development: use direct IP
# For PRODUCTION (Render): use ZeroTier gateway
ROUTER_IP=192.168.10.1
ROUTER_PROTOCOL=http
ROUTER_USER=admin
ROUTER_PASS=admin

# Server Configuration
PORT=3000

# Optional: Enable debug logging
DEBUG=false

# Production settings (Render.com with ZeroTier):
# ROUTER_IP=http://pooh-zerotier-gateway:10000
# ROUTER_PROTOCOL=http

# ZeroTier settings (for gateway service):
# ZEROTIER_NETWORK_ID=your_network_id
# ROUTER_ZEROTIER_IP=10.147.17.5  # Router IP in ZeroTier network
